<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@+id/radio_widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
 android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="@drawable/widget_background_standard">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="راديو القرآن" android:textColor="#E5CE86" android:textSize="12sp"/>
 <TextView android:id="@+id/radio_widget_station" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="إذاعة القرآن الكريم من القاهرة" android:textColor="#EDF1E7" android:textStyle="bold" android:textSize="16sp" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/radio_widget_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اضغط للتشغيل" android:textColor="#AFC0B1" android:textSize="12sp" android:layout_marginTop="4dp"/>
 <Button android:id="@+id/radio_widget_toggle" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="تشغيل" android:textColor="#10271B" android:backgroundTint="#E5CE86"/>
</LinearLayout>
