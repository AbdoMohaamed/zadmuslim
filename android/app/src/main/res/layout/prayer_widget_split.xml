<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="center_horizontal"
    android:background="@drawable/widget_background_split">

    <!-- شريط المدينة وزر التحديث -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="المدينة"
            android:textSize="12sp"
            android:textColor="#E6CA65"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="↻"
            android:textSize="16sp"
            android:textColor="#E6CA65"
            android:contentDescription="تحديث المواقيت" />
    </LinearLayout>

    <!-- بطاقة الصلاة القادمة المركزية -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:padding="6dp"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/widget_surface_split">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="الصلاة القادمة"
            android:textSize="9sp"
            android:textColor="#E6CA65" />

        <TextView
            android:id="@+id/widget_txt_next_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="مواقيت الصلاة"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_txt_next_prayer_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="22sp"
            android:textColor="#FFD4AF37"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_txt_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متبقي عليها"
            android:textSize="9sp"
            android:textColor="#95B5A8"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- شريط الصلوات الخمس المصغر -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/col_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:orientation="vertical"
            android:padding="2dp"
            android:gravity="center"
            android:background="@drawable/widget_prayer_col_normal">

            <TextView
                android:id="@+id/widget_label_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="فجر"
                android:textSize="8sp"
                android:textColor="#8FAEA1" />

            <TextView
                android:id="@+id/widget_time_fajr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="8.5sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/col_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:orientation="vertical"
            android:padding="2dp"
            android:gravity="center"
            android:background="@drawable/widget_prayer_col_normal">

            <TextView
                android:id="@+id/widget_label_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ظهر"
                android:textSize="8sp"
                android:textColor="#8FAEA1" />

            <TextView
                android:id="@+id/widget_time_dhuhr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="8.5sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/col_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:orientation="vertical"
            android:padding="2dp"
            android:gravity="center"
            android:background="@drawable/widget_prayer_col_normal">

            <TextView
                android:id="@+id/widget_label_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عصر"
                android:textSize="8sp"
                android:textColor="#8FAEA1" />

            <TextView
                android:id="@+id/widget_time_asr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="8.5sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/col_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:orientation="vertical"
            android:padding="2dp"
            android:gravity="center"
            android:background="@drawable/widget_prayer_col_normal">

            <TextView
                android:id="@+id/widget_label_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="مغرب"
                android:textSize="8sp"
                android:textColor="#8FAEA1" />

            <TextView
                android:id="@+id/widget_time_maghrib"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="8.5sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/col_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="1dp"
            android:orientation="vertical"
            android:padding="2dp"
            android:gravity="center"
            android:background="@drawable/widget_prayer_col_normal">

            <TextView
                android:id="@+id/widget_label_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عشاء"
                android:textSize="8sp"
                android:textColor="#8FAEA1" />

            <TextView
                android:id="@+id/widget_time_isha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textSize="8.5sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- عناصر البيانات التكميلية -->
    <TextView
        android:id="@+id/widget_txt_hijri_date"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="التاريخ الهجري" />

    <TextView
        android:id="@+id/widget_txt_gregorian_date"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="التاريخ الميلادي" />

    <TextView
        android:id="@+id/widget_txt_dhikr"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:text="أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ" />
</LinearLayout>
