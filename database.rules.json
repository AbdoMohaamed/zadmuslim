{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false }
    },
    "admin_settings": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "pin": { ".validate": false },
      "onesignal": { "rest_key": { ".validate": false } }
    },
    "public_config": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "onesignal_app_id": { ".validate": "newData.isString() && newData.val().length === 36" },
      "$other": { ".validate": false }
    },
    "push_subscribers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['id', 'updatedAt'])",
        "id": { ".validate": "newData.isString() && newData.val() === $uid" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "userAgent": { ".validate": "newData.isString() && newData.val().length < 1000" },
        "platform": { ".validate": "newData.isString() && newData.val().length < 100" },
        "language": { ".validate": "newData.isString() && newData.val().length < 100" },
        "subscription": {
          ".validate": "newData.hasChildren(['endpoint', 'keys'])",
          "endpoint": { ".validate": "newData.isString() && newData.val().length < 4096" },
          "expirationTime": { ".validate": "newData.isNumber()" },
          "keys": {
            "auth": { ".validate": "newData.isString() && newData.val().length < 300" },
            "p256dh": { ".validate": "newData.isString() && newData.val().length < 300" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "push_broadcasts": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": ["timestamp"]
    },
    "media_library": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "deleted_media_ids": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "stats": {
      ".read": true,
      "$counter": {
        ".write": "newData.isNumber() && ((!data.exists() && newData.val() >= 0 && newData.val() <= 25000) || (data.isNumber() && newData.val() >= data.val() && newData.val() <= data.val() + 1000))",
        "$key": {
          ".write": "newData.isNumber() && ((!data.exists() && newData.val() === 1) || (data.isNumber() && newData.val() === data.val() + 1))"
        }
      }
    },
    "prayers": {
      ".read": true,
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['text']) && newData.child('text').isString() && newData.child('text').val().length <= 3000",
        "amenCount": { ".write": "data.isNumber() && newData.isNumber() && newData.val() === data.val() + 1" }
      }
    },
    "community_duas": {
      ".read": true,
      ".indexOn": ["timestamp"],
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['text', 'author', 'category', 'timestamp']) && newData.child('text').isString() && newData.child('text').val().length <= 3000 && newData.child('author').isString() && newData.child('author').val().length <= 100",
        "amenCount": { ".write": "data.isNumber() && newData.isNumber() && newData.val() === data.val() + 1" }
      }
    },
    "khatma": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "parts": {
        "$part": {
          ".write": "newData.hasChildren(['id', 'status', 'reader', 'time']) && newData.child('id').isNumber() && newData.child('id').val() >= 1 && newData.child('id').val() <= 30 && newData.child('reader').isString() && newData.child('reader').val().length <= 100 && (newData.child('status').val() === 'reading' || newData.child('status').val() === 'completed')"
        }
      }
    },
    "user_reports": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['details']) && newData.child('details').isString() && newData.child('details').val().length <= 5000"
      }
    }
  }
}
